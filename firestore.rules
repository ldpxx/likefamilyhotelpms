rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrapOpen() {
      return isSignedIn() &&
        !exists(/databases/$(database)/documents/system_meta/bootstrap);
    }

    function bootstrapData() {
      return get(/databases/$(database)/documents/system_meta/bootstrap).data;
    }

    function isMatchingSuperAdminEmail() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        exists(/databases/$(database)/documents/system_meta/bootstrap) && (
          ('superAdminEmail' in bootstrapData() &&
            bootstrapData().superAdminEmail.lower() == request.auth.token.email.lower()) ||
          ('ownerEmail' in bootstrapData() &&
            bootstrapData().ownerEmail.lower() == request.auth.token.email.lower())
        );
    }

    function isSuperAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/system_meta/bootstrap) && (
          ('superAdminUid' in bootstrapData() && bootstrapData().superAdminUid == request.auth.uid) ||
          ('ownerUid' in bootstrapData() && bootstrapData().ownerUid == request.auth.uid) ||
          isMatchingSuperAdminEmail()
        );
    }

    function hasStaffDoc() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/staff_users/$(request.auth.uid));
    }

    function staffData() {
      return get(/databases/$(database)/documents/staff_users/$(request.auth.uid)).data;
    }

    function isActiveStaff() {
      return isSuperAdmin() || (hasStaffDoc() && staffData().isActive == true);
    }

    function isOwnerOrSuperAdmin() {
      return isSuperAdmin() || (hasStaffDoc() && staffData().isActive == true && staffData().role == 'owner');
    }

    function isManagerOrAbove() {
      return isSuperAdmin() || (
        hasStaffDoc() &&
        staffData().isActive == true && (
          staffData().role in ['owner', 'manager'] ||
          ('permissions' in staffData() && staffData().permissions.canManageStaff == true)
        )
      );
    }

    // Bug #11a: Enforce Accounting Period Lock (ISO YYYY-MM-DD comparison) directly in Firestore Rules
    function isPeriodOpenForDate(txDate) {
      return !exists(/databases/$(database)/documents/hotel_config/main) ||
        !('accountingLockDate' in get(/databases/$(database)/documents/hotel_config/main).data) ||
        get(/databases/$(database)/documents/hotel_config/main).data.accountingLockDate == null ||
        get(/databases/$(database)/documents/hotel_config/main).data.accountingLockDate == '' ||
        (txDate is string && txDate > get(/databases/$(database)/documents/hotel_config/main).data.accountingLockDate);
    }

    // Single Root SuperAdmin bootstrap sentinel
    match /system_meta/bootstrap {
      allow get: if true;
      allow create: if isBootstrapOpen() &&
        request.resource.data.superAdminUid == request.auth.uid;
      allow update: if isMatchingSuperAdminEmail() &&
        request.resource.data.superAdminUid == request.auth.uid;
      allow delete: if false;
    }

    // Gemini AI API Keys — strictly SuperAdmin write/list; active signed-in staff read via get for OCR
    match /system_config/{docId} {
      allow get: if isActiveStaff();
      allow list, write: if isSuperAdmin();
    }

    // Protect Firestore 1MB document limit when saving centralized hotel logo Base64
    function validHotelLogo() {
      return !('hotelLogoBase64' in request.resource.data) ||
        request.resource.data.hotelLogoBase64 == null ||
        (request.resource.data.hotelLogoBase64 is string &&
          request.resource.data.hotelLogoBase64.size() < 150000);
    }

    // Bug #3: Hotel & VietQR global config — SuperAdmin full write; Owner may update accountingLockDate, bookingSources, otaChannels, hourlyCleaningBufferMinutes, configMigrationVersion, hotelLogoBase64
    match /hotel_config/{docId} {
      allow read: if isActiveStaff();
      allow create: if isSuperAdmin() && validHotelLogo();
      allow update: if validHotelLogo() && (
        isSuperAdmin() || (
          isOwnerOrSuperAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'accountingLockDate',
            'bookingSources',
            'otaChannels',
            'hourlyCleaningBufferMinutes',
            'configMigrationVersion',
            'hotelLogoBase64',
            'serviceCatalog',
            'wifiSsid',
            'wifiPassword',
            'wifiDisplayText',
            'updatedAt'
          ])
        )
      );
      allow delete: if false;
    }

    // Bug #8: Staff accounts strictly protected (Firebase Auth required, ZERO passwordHash allowed!)
    match /staff_users/{staffId} {
      allow get: if (isSignedIn() && request.auth.uid == staffId) ||
        isSuperAdmin() ||
        isManagerOrAbove();
      allow list: if isManagerOrAbove();
      allow create: if !('passwordHash' in request.resource.data) && (
        isManagerOrAbove() ||
        isBootstrapOpen() ||
        isMatchingSuperAdminEmail()
      );
      allow update: if !('passwordHash' in request.resource.data) && (
        isManagerOrAbove() ||
        (
          hasStaffDoc() &&
          staffData().isActive == true &&
          request.auth.uid == staffId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'fullName',
            'phone',
            'mustChangePassword',
            'updatedAt'
          ])
        )
      );
      allow delete: if isManagerOrAbove() && staffId != request.auth.uid;
    }

    // Form templates (Web App Form Customizer)
    match /form_templates/{templateId} {
      allow read, create, update: if isActiveStaff();
      allow delete: if false;
    }

    // Room types & Rooms — HARD DELETE PERMANENTLY BLOCKED to preserve historical bookings & reports
    match /room_types/{typeId} {
      allow read, create, update: if isActiveStaff();
      allow delete: if false;
    }

    match /rooms/{roomId} {
      allow read, create, update: if isActiveStaff();
      allow delete: if false;
    }

    // Guest documents (Compressed Base64 ID/Passport/Visa/Entry Stamp images)
    // Hard delete or Base64 cleanup strictly restricted to SuperAdmin
    match /guest_documents/{docId} {
      allow read, create: if isActiveStaff();
      allow update: if isActiveStaff() && (request.resource.data.isCleaned != true || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // Core operational collections (Strictly Authenticated Active Staff / SuperAdmin)
    match /guests/{guestId} {
      allow read, create, update: if isActiveStaff();
      // Protect system default WALK_IN_DEFAULT from deletion; allow Owner/SuperAdmin to clean up duplicate walk-in docs
      allow delete: if guestId != 'WALK_IN_DEFAULT' && isOwnerOrSuperAdmin();
    }

    // Manual Customer Groups (CRM classification — no auto-labeling)
    match /customer_groups/{groupId} {
      allow read, create, update, delete: if isActiveStaff();
    }

    match /bookings/{bookingId} {
      allow read, create, update: if isActiveStaff();
      allow delete: if isSuperAdmin();
    }

    // Atomic room occupancy index (`room_occupancy/{roomId}_{YYYY-MM-DD}`) — v2.2.2 BUG-02
    function validOccupancyDoc() {
      return request.resource.data.keys().hasOnly(['roomId', 'date', 'intervals', 'updatedAt']) &&
        request.resource.data.keys().hasAll(['roomId', 'date', 'intervals', 'updatedAt']) &&
        request.resource.data.roomId is string &&
        request.resource.data.roomId.size() > 0 &&
        request.resource.data.date is string &&
        request.resource.data.date.size() == 10 &&
        request.resource.data.intervals is list &&
        request.resource.data.updatedAt is string;
    }

    match /room_occupancy/{occId} {
      allow read: if isActiveStaff();
      allow create, update: if isActiveStaff() && validOccupancyDoc();
      allow delete: if isSuperAdmin();
    }

    match /booking_groups/{groupId} {
      allow read, create, update: if isActiveStaff();
      allow delete: if isSuperAdmin();
    }

    match /room_maintenances/{maintId} {
      allow read, create, update: if isActiveStaff();
      allow delete: if isSuperAdmin();
    }

    match /ota_payout_batches/{batchId} {
      allow read, create, update: if isActiveStaff();
      allow delete: if isSuperAdmin();
    }

    match /shift_handovers/{handoverId} {
      allow read, create, update: if isActiveStaff();
      allow delete: if isSuperAdmin();
    }

    // IMMUTABLE FINANCIAL LEDGER (v2.2.1):
    // - Enforces Accounting Period Lock (`date > accountingLockDate`) on create.
    // - Original transactions can NEVER be edited or deleted directly (`allow update, delete: if false;`).
    match /transactions/{txId} {
      allow read: if isActiveStaff();
      allow create: if isActiveStaff() && isPeriodOpenForDate(request.resource.data.date);
      allow update, delete: if false;
    }

    // Post-checkout adjustment history — immutable ledger + Period Lock
    match /post_checkout_adjustments/{adjId} {
      allow read: if isActiveStaff();
      allow create: if isActiveStaff() && isPeriodOpenForDate(request.resource.data.accountingDate);
      allow update, delete: if false;
    }

    // Post-reconciliation OTA adjustments — carry forward to next payout batch, NEVER hard delete
    match /ota_adjustments/{adjId} {
      allow read, create, update: if isActiveStaff();
      allow delete: if false;
    }

    // IMMUTABLE AUDIT LOGS: permanently forbids update and delete
    match /audit_logs/{logId} {
      allow read, create: if isActiveStaff();
      allow update, delete: if false;
    }
  }
}
