# Like Family PMS — Environment Variables Template
# Copy this file to .env and fill in your Firebase project credentials

VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Optional fallback Gemini API keys (recommended: configure inside SuperAdmin Settings)
VITE_GEMINI_API_KEYS=

# Default VietQR bank settings (editable inside SuperAdmin Settings)
VITE_VIETQR_BANK_ID=MB
VITE_VIETQR_ACCOUNT_NO=
VITE_VIETQR_ACCOUNT_NAME=
